# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" and never paste your real token anywhere public.

# Token from @BotFather (looks like 123456789:AAxxxxxxxx...)
BOT_TOKEN=

# Numeric Telegram user IDs of the administrators, comma-separated.
# Get yours from a bot such as @userinfobot. Usernames do NOT work.
ADMIN_IDS=

# IANA timezone of the business. Slots are typed and shown in this timezone.
BUSINESS_TIMEZONE=Asia/Tehran

# Name shown in the welcome message (fictional demo name by default).
BUSINESS_NAME=Slotly Demo

# Customers may cancel until this many minutes before the appointment.
CANCELLATION_CUTOFF_MINUTES=120

# Maximum number of upcoming bookings per customer.
MAX_ACTIVE_BOOKINGS=3

# SQLite file. A relative path is resolved from the project folder.
DATABASE_PATH=slotly.db
